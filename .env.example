PORT=3000

# Leave these blank to run in DEV MODE (OTP is always 123456, logged to console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Leave these blank to run in DEV MODE for social login too.
# Dev token format: base64 of {"email":"you@example.com"}
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Leave AWS_ACCESS_KEY_ID blank to run face verification in DEV MODE
# (pass {"simulate":"pass"|"fail"} in the /verify/face/result body to test both paths)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
